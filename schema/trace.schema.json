{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/therealfullmetal55555/bench-suite/schema/trace.schema.json",
  "title": "bench trace",
  "description": "What a target must produce for one task. Generated from src/bench/core/trace.py \u2014 do not edit by hand, run `bench schema write`.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant",
              "tool"
            ],
            "title": "Role",
            "type": "string"
          },
          "content": {
            "default": "",
            "title": "Content",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          }
        },
        "required": [
          "role"
        ],
        "title": "Message",
        "type": "object"
      }
    },
    "output": {
      "type": [
        "string",
        "null"
      ]
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "arguments": {
            "additionalProperties": true,
            "title": "Arguments",
            "type": "object"
          },
          "result": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Error"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          }
        },
        "required": [
          "name"
        ],
        "title": "ToolCall",
        "type": "object"
      }
    },
    "retrieved": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "One retrieved chunk, kept with the trace rather than looked up later.\n\nThe reason is that a score has to be explainable a year from now: \"the answer\ncited passage 3, and passage 3 says the rollout was stopped by a permission\nchange\" is a claim that survives the corpus being edited. A retrieval id alone\ndoes not.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Score"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "Passage",
        "type": "object"
      }
    },
    "tokens": {
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "default": 0,
          "title": "Prompt",
          "type": "integer"
        },
        "completion": {
          "default": 0,
          "title": "Completion",
          "type": "integer"
        },
        "cached": {
          "default": 0,
          "title": "Cached",
          "type": "integer"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "steps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "raw": {
      "type": "object"
    }
  }
}
